########################################################################
# minireg configuration
#
#   cp .env.example .env
#
# Generate the two secrets with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
########################################################################

# ---------------------------------------------------------------------
# REQUIRED
# ---------------------------------------------------------------------

# Signs session cookies and OIDC login state. Changing it logs everyone out.
SECRET_KEY=change-me-generate-a-long-random-value

# The URL clients actually use to reach this registry.
# Tarball and file URLs in every packument and simple-index page are rendered
# against this value, so it must be exactly right -- including the scheme,
# port, and any reverse-proxy hostname. `npm install` breaks otherwise.
PUBLIC_URL=http://localhost:8000

# ---------------------------------------------------------------------
# Network binding
# ---------------------------------------------------------------------
# Defaults to loopback. Set to 0.0.0.0 to expose directly, or leave as-is
# and put a TLS-terminating reverse proxy in front (recommended).
BIND_ADDRESS=127.0.0.1
PORT=8000

# ---------------------------------------------------------------------
# Database / cache
# ---------------------------------------------------------------------
POSTGRES_USER=minireg
POSTGRES_PASSWORD=change-me-too
POSTGRES_DB=minireg
REDIS_MAXMEMORY=512mb
DB_POOL_SIZE=20
# shared_buffers is a real reservation taken out of the host's RAM. The default
# suits a box shared with the app and valkey; only raise it toward ~25% of RAM
# if postgres has a machine to itself.
POSTGRES_SHARED_BUFFERS=256MB

# ---------------------------------------------------------------------
# Container memory limits
# ---------------------------------------------------------------------
# Caps each container in its own cgroup. These matter: with no limit the
# kernel's OOM killer chooses a victim host-wide, and on a small host it has
# picked the docker daemon -- which stops postgres and valkey and leaves them
# stopped. With limits, a runaway registry process restarts by itself.
# Defaults suit a 4GB host; the three together should leave the OS ~512MB.
MINIREG_MEM_LIMIT=1536m
POSTGRES_MEM_LIMIT=1g
REDIS_MEM_LIMIT=768m

# ---------------------------------------------------------------------
# Initial admin account
# ---------------------------------------------------------------------
# Created on first start, only when the database has no users at all.
# Leave the password blank and one is generated and printed to the logs once:
#   docker compose logs minireg | grep -A4 "initial admin"
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_EMAIL=admin@example.com

# ---------------------------------------------------------------------
# Access control
# ---------------------------------------------------------------------
# true  -> anyone who can reach the registry can install packages (typical
#          for an internal mirror; the web UI still requires a login)
# false -> npm/pip must present an API token to read
ALLOW_ANONYMOUS_READ=true

# ---------------------------------------------------------------------
# Upstream trust
# ---------------------------------------------------------------------
# Artifact URLs come from upstream metadata, so a hostile or misconfigured
# upstream chooses them. Fetches are restricted to the upstream's own host
# plus this list, and never go to a private or link-local address.
# Add a host here when an upstream serves its files from a separate CDN.
#UPSTREAM_ARTIFACT_HOSTS=registry.npmjs.org,files.pythonhosted.org,pypi.org,static.crates.io,crates.io,index.crates.io
# Set true for a self-hosted GitLab or mirror on an internal address.
#UPSTREAM_ALLOW_PRIVATE_ADDRESSES=false
#UPSTREAM_ALLOW_PLAINTEXT_HTTP=false

# ---------------------------------------------------------------------
# Limits
# ---------------------------------------------------------------------
# Publish bodies are rejected on Content-Length before being read. npm sends
# the tarball base64'd inside a JSON document, so peak memory is several times
# the artifact size.
#MAX_PUBLISH_BYTES=268435456
#MAX_METADATA_BYTES=100663296
#MAX_ARTIFACT_BYTES=2147483648
# Stop caching new upstream artifacts above this. Publishes stay allowed:
# a local package exists nowhere else, a cached one can be re-fetched.
#STORAGE_QUOTA_BYTES=0

# ---------------------------------------------------------------------
# Rate limits (requests per minute)
# ---------------------------------------------------------------------
# The client address is taken this many hops from the right of
# X-Forwarded-For. Everything further left was written by the caller, so
# reading the left-most entry lets anyone choose their own rate-limit bucket
# and their own audit-log address.
#TRUSTED_PROXY_HOPS=1
# Anonymous reads are counted per client IP; authenticated requests per user.
# CI runners behind one NAT address all share the anonymous budget, so either
# raise it here or give CI a read token so it draws on the per-user limit.
# A rejected request gets a 429 with Retry-After set to the window's rollover.
#RATE_LIMIT_ENABLED=true
#RATE_LIMIT_ANONYMOUS_PER_MINUTE=600
#RATE_LIMIT_AUTHENTICATED_PER_MINUTE=3000
#RATE_LIMIT_PUBLISH_PER_MINUTE=60
#RATE_LIMIT_LOGIN_PER_MINUTE=10

# ---------------------------------------------------------------------
# OIDC / Authentik
# ---------------------------------------------------------------------
OIDC_ENABLED=false

# Authentik's issuer is per-application and includes a trailing slash:
#   https://authentik.example.com/application/o/minireg/
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Members of this group become administrators on every sign-in. Removing
# someone from the group demotes them the next time they log in.
OIDC_ADMIN_GROUP=minireg-admins

# If set, only members of this group may sign in at all. Blank = anyone the
# provider authenticates.
OIDC_USER_GROUP=

# Create a local account automatically on first SSO sign-in.
OIDC_AUTO_CREATE_USERS=true

# Authentik ships groups in the `groups` claim once the scope mapping is
# added to the provider. Change this only for a non-Authentik IdP.
OIDC_GROUPS_CLAIM=groups

# ---------------------------------------------------------------------
# CVE scanning (OSV.dev)
# ---------------------------------------------------------------------
OSV_ENABLED=true

# Scan a package version the first time it is seen, before it is served.
OSV_INLINE_SCAN=true

# Budget for that inline scan. Exceeding it does not block the request; the
# version is marked unscanned and a background scan is queued.
OSV_INLINE_TIMEOUT_SECONDS=4

# Blocking thresholds are configured in the admin UI (Package policy), not
# here, so they can be changed without a restart.

# ---------------------------------------------------------------------
# Performance
# ---------------------------------------------------------------------
# How long a cached packument / simple-index page stays fresh. Artifacts are
# immutable and cached forever regardless of this value.
META_CACHE_TTL=60

# Race every upstream within a tier and take the first success. Turn off to
# try them one at a time in priority order (fewer upstream requests, slower).
UPSTREAM_TIER_PARALLEL=true

# ---------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------
ENVIRONMENT=prod
LOG_LEVEL=INFO

# Encrypts stored upstream credentials. Derived from SECRET_KEY when blank.
CREDENTIAL_KEY=
